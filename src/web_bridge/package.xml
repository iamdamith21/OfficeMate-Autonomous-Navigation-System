<?xml version="1.0"?>
<package format="3">
  <name>web_bridge</name>
  <version>3.0.0</version>
  <description>Bridge between ROS 2 and the OfficeMate web app: rosbridge_server + API adapters (mission requests, state, telemetry).</description>
  <maintainer email="cldac@buyjustnow.com">damith</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
