<?xml version="1.0"?>
<package format="3">
  <name>mission_manager</name>
  <version>3.0.0</version>
  <description>Delivery mission state machine (delivery_manager) and task scheduler — orchestrates navigation, RFID verification and door control.</description>
  <maintainer email="cldac@buyjustnow.com">damith</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
