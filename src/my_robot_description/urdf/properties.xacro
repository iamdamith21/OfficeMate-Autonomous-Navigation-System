<?xml version="1.0"?>
<!--
  Robot dimensional properties — single source of truth (chassis v3, 4WD).
  All distances in metres, masses in kg.  ROS REP-103: X fwd, Y left, Z up.
  base_link origin is at wheel-axis height above ground.

  Enclosure (bottom → top):
    tier 1  solid BLACK box (no doors)
    tier 2  GREY file compartment (hollow) with a split double-door on the front
    tier 3  BLACK top deck (surface) carrying the lidar + centred RFID reader

  Minimal TF: all static structure lives on base_link (multiple visuals) so it
  produces NO extra TF frames. Only functional links get their own frame:
  base_footprint, base_link, laser, imu_link, ultrasonic_link, the 4 wheels,
  and the 2 (moving) doors.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── Math ── -->
  <xacro:property name="PI" value="3.14159265358979323846"/>

  <!-- ── Footprint envelope ── -->
  <xacro:property name="body_length"  value="0.400"/>   <!-- X 40 cm -->
  <xacro:property name="body_width"   value="0.300"/>   <!-- Y 30 cm -->
  <xacro:property name="panel_thickness" value="0.012"/>
  <xacro:property name="chassis_thickness" value="0.020"/>

  <!-- ── Drive wheels (130 mm Ø, 60 mm wide) ── -->
  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_width"  value="0.060"/>
  <xacro:property name="wheel_y_offset" value="0.165"/>
  <!-- 4WD skid-steer half-wheelbase. PLACEHOLDER: real front↔rear axle / 2 -->
  <xacro:property name="wheel_x_offset" value="0.150"/>

  <!-- ── Ground clearance (wheels lowered) ── -->
  <xacro:property name="ground_clearance" value="0.020"/>
  <xacro:property name="struct_bottom_z" value="${-(wheel_radius - ground_clearance)}"/> <!-- -0.045 -->

  <!-- ── Tier heights (stack up from struct_bottom_z) ── -->
  <xacro:property name="bottom_black_h" value="0.245"/>
  <xacro:property name="compartment_h"  value="0.317"/>   <!-- grey file compartment -->
  <xacro:property name="deck_h"         value="0.018"/>

  <!-- Derived Z centres/levels (from base_link) -->
  <xacro:property name="bottom_black_center_z" value="${struct_bottom_z + bottom_black_h/2.0}"/>          <!-- 0.0775 -->
  <xacro:property name="bottom_black_top_z"    value="${struct_bottom_z + bottom_black_h}"/>              <!-- 0.200 -->
  <xacro:property name="compartment_center_z"  value="${bottom_black_top_z + compartment_h/2.0}"/>        <!-- 0.3585 -->
  <xacro:property name="compartment_top_z"     value="${bottom_black_top_z + compartment_h}"/>            <!-- 0.517 -->
  <xacro:property name="deck_center_z"         value="${compartment_top_z + deck_h/2.0}"/>                <!-- 0.526 -->
  <xacro:property name="deck_top_z"            value="${compartment_top_z + deck_h}"/>                    <!-- 0.535 → 0.600 ground -->

  <!-- ── Split double-door (front of the GREY middle compartment) ── -->
  <xacro:property name="door_height"    value="0.280"/>
  <xacro:property name="door_width"     value="0.145"/>   <!-- each panel (Y) -->
  <xacro:property name="door_thickness" value="0.012"/>

  <!-- ── RFID reader (MFRC522) — centred on the deck front-edge line ── -->
  <xacro:property name="rfid_l" value="0.060"/>
  <xacro:property name="rfid_w" value="0.040"/>
  <xacro:property name="rfid_h" value="0.008"/>
  <xacro:property name="rfid_x" value="${body_length/2.0 - rfid_l/2.0 - 0.02}"/>  <!-- front-edge line -->

  <!-- ── HC-SR04 ultrasonic (blue PCB + 2 black transducers + silver crystal) ── -->
  <xacro:property name="us_pcb_w"    value="0.045"/>   <!-- board Y -->
  <xacro:property name="us_pcb_h"    value="0.020"/>   <!-- board Z -->
  <xacro:property name="us_pcb_t"    value="0.0015"/>  <!-- board X (thin) -->
  <xacro:property name="us_tx_radius" value="0.008"/>  <!-- transducer can -->
  <xacro:property name="us_tx_length" value="0.012"/>
  <xacro:property name="us_tx_sep"    value="0.026"/>  <!-- centre-to-centre -->
  <xacro:property name="us_height_above_ground" value="0.100"/>

  <!-- ── LTME-02A lidar (70 mm Ø, 60 mm tall) ── -->
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.060"/>

  <!-- ── Masses ── -->
  <xacro:property name="body_mass"  value="3.000"/>
  <xacro:property name="wheel_mass" value="0.200"/>
  <xacro:property name="lidar_mass" value="0.200"/>

</robot>
