<?xml version="1.0"?>
<!--
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  my_robot — 4WD Skid-Steer Robot URDF (chassis v3)                     │
  │                                                                         │
  │  TF tree                                                                │
  │  base_footprint                                                         │
  │    └─[base_joint fixed z=0.065]─► base_link                            │
  │         ├─[body_joint fixed]──────► body_link                           │
  │         │    └─[laser_joint cont Z]► laser      (LiDAR frame)           │
  │         ├─[front_left_wheel_joint  cont Y]► front_left_wheel_link       │
  │         ├─[front_right_wheel_joint cont Y]► front_right_wheel_link      │
  │         ├─[rear_left_wheel_joint   cont Y]► rear_left_wheel_link        │
  │         └─[rear_right_wheel_joint  cont Y]► rear_right_wheel_link       │
  │                                                                         │
  │  4WD skid-steer: 4 fixed-mount drive wheels, NO casters.                │
  │                                                                         │
  │  Heights from ground                                                    │
  │    base_link              0.065 m  (wheel radius)                       │
  │    body top / laser mount 0.600 m                                       │
  │    laser centre           0.630 m                                       │
  └─────────────────────────────────────────────────────────────────────────┘
-->
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── Shared utilities ── -->
  <xacro:include filename="$(find my_robot_description)/urdf/properties.xacro"/>
  <xacro:include filename="$(find my_robot_description)/urdf/inertials.xacro"/>
  <xacro:include filename="$(find my_robot_description)/urdf/materials.xacro"/>

  <!-- ── Sub-components ── -->
  <xacro:include filename="$(find my_robot_description)/urdf/base/base.xacro"/>
  <xacro:include filename="$(find my_robot_description)/urdf/wheels/drive_wheel.xacro"/>
  <!-- caster_wheel.xacro no longer used: chassis v3 is 4WD skid-steer -->
  <xacro:include filename="$(find my_robot_description)/urdf/sensors/lidar.xacro"/>
  <xacro:include filename="$(find my_robot_description)/urdf/sensors/imu.xacro"/>
  <xacro:include filename="$(find my_robot_description)/urdf/sensors/ultrasonic.xacro"/>

  <!-- ── Instantiate robot ── -->

  <!-- Base structure: footprint + chassis + enclosure box -->
  <xacro:base/>

  <!-- Drive wheels: 4WD skid-steer — one at each corner (front/rear × L/R) -->
  <xacro:drive_wheel prefix="front_left"  x_pos="${wheel_x_offset}"  y_reflect=" 1"/>
  <xacro:drive_wheel prefix="front_right" x_pos="${wheel_x_offset}"  y_reflect="-1"/>
  <xacro:drive_wheel prefix="rear_left"   x_pos="${-wheel_x_offset}" y_reflect=" 1"/>
  <xacro:drive_wheel prefix="rear_right"  x_pos="${-wheel_x_offset}" y_reflect="-1"/>

  <!-- RPLidar on top of body, frame named "laser" (sllidar_ros2 default) -->
  <xacro:lidar/>

  <!-- MPU9250 on the electronics deck; HC-SR04 front-low (arduino_bridge frames) -->
  <xacro:imu/>
  <xacro:ultrasonic/>

</robot>
