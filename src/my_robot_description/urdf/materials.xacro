<?xml version="1.0"?>
<!-- Named materials used for RViz visualisation -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>

  <material name="chassis_grey">
    <color rgba="0.45 0.35 0.20 1.0"/>  <!-- plywood tan -->
  </material>

  <material name="wheel_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="wheel_hub_blue">
    <color rgba="0.20 0.20 0.80 1.0"/>  <!-- purple-blue alloy rim -->
  </material>

  <material name="caster_grey">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <material name="lidar_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

</robot>
