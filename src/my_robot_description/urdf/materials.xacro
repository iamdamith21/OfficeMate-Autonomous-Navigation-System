<?xml version="1.0"?>
<!-- Named materials for RViz visualisation (chassis v3 palette). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Enclosure / structure = black -->
  <material name="enclosure_black">
    <color rgba="0.08 0.08 0.09 1.0"/>
  </material>

  <!-- File compartment = grey -->
  <material name="compartment_grey">
    <color rgba="0.55 0.55 0.57 1.0"/>
  </material>

  <!-- Top deck surface + lidar = black -->
  <material name="deck_black">
    <color rgba="0.10 0.10 0.11 1.0"/>
  </material>
  <material name="lidar_black">
    <color rgba="0.06 0.06 0.07 1.0"/>
  </material>

  <!-- RFID reader = blue -->
  <material name="rfid_blue">
    <color rgba="0.10 0.35 0.85 1.0"/>
  </material>

  <!-- Ultrasonic "eyes" = grey -->
  <material name="ultrasonic_grey">
    <color rgba="0.60 0.60 0.62 1.0"/>
  </material>

  <!-- Wheels = black, hub accent -->
  <material name="wheel_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>
  <material name="wheel_hub_blue">
    <color rgba="0.20 0.20 0.80 1.0"/>
  </material>

  <!-- Chassis plate (hidden, low) -->
  <material name="chassis_grey">
    <color rgba="0.30 0.30 0.32 1.0"/>
  </material>

</robot>
