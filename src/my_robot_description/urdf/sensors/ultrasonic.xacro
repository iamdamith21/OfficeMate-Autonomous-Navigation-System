<?xml version="1.0"?>
<!--
  HC-SR04 ultrasonic on the compartment front face, ~10 cm above ground,
  pointing forward (+X). Modelled as the sensor's twin transducers — two
  grey "eyes". Frame "ultrasonic_link" (frame_id of /ultrasonic/range) sits
  at the pair centre with +X = measurement direction.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="ultrasonic" params="">

    <link name="ultrasonic_link">
      <!-- left eye -->
      <visual>
        <origin xyz="0 ${us_eye_sep/2.0} 0" rpy="0 ${PI/2.0} 0"/>
        <geometry><cylinder radius="${us_eye_radius}" length="${us_eye_length}"/></geometry>
        <material name="ultrasonic_grey"/>
      </visual>
      <!-- right eye -->
      <visual>
        <origin xyz="0 ${-us_eye_sep/2.0} 0" rpy="0 ${PI/2.0} 0"/>
        <geometry><cylinder radius="${us_eye_radius}" length="${us_eye_length}"/></geometry>
        <material name="ultrasonic_grey"/>
      </visual>
    </link>

    <joint name="ultrasonic_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="ultrasonic_link"/>
      <!-- x: compartment front face; z: us_height_above_ground − wheel_radius -->
      <origin xyz="${body_length/2.0} 0 ${us_height_above_ground - wheel_radius}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
