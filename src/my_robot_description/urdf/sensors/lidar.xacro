<?xml version="1.0"?>
<!--
  LTME-02A lidar on the top deck. Frame "laser" (driver frame_id).
  FIXED joint (parented straight to base_link since the deck is not its own
  frame): base->laser is on /tf_static — a moving joint would ride dynamic
  /tf at the joint-state rate and the 30 Hz scans would be dropped by SLAM.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="lidar" params="">

    <link name="laser">
      <visual>
        <origin xyz="0 0 ${lidar_height/2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
        <material name="lidar_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${lidar_height/2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      </collision>
      <xacro:cylinder_inertia_z m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
    </link>

    <!-- On the deck top surface, centred (270° FOV faces forward). -->
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="laser"/>
      <origin xyz="0 0 ${deck_top_z}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
