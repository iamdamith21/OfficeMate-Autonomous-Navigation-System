<?xml version="1.0"?>
<!--
  LTME-02A lidar on the top deck. Frame "laser" (driver frame_id).
  FIXED joint: the frame does not rotate in real use (driver outputs
  de-rotated scans) so base->laser is on /tf_static — a continuous joint
  would ride dynamic /tf at the joint-state rate and cause the 30 Hz scans
  to be dropped by SLAM/Nav2.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="lidar" params="">

    <link name="laser">
      <visual>
        <origin xyz="0 0 ${lidar_height/2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
        <material name="lidar_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${lidar_height/2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      </collision>
      <xacro:cylinder_inertia_z m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
    </link>

    <!-- Mounted on the deck top surface, centred (270° FOV faces forward). -->
    <joint name="laser_joint" type="fixed">
      <parent link="deck_link"/>
      <child  link="laser"/>
      <origin xyz="0 0 ${deck_thickness/2.0}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
