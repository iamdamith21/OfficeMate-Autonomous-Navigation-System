<?xml version="1.0"?>
<!--
  MPU6050 IMU (frame_id of /imu/data_raw). Mounted at the CENTRE OF THE BASE
  (base_link), axes per REP-103 (X fwd, Y left, Z up). If the physical module
  is rotated on the deck, correct it here with imu_joint rpy — never in code.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="imu" params="">

    <link name="imu_link">
      <visual>
        <geometry><box size="0.025 0.020 0.005"/></geometry>
        <material name="enclosure_black"/>
      </visual>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="imu_link"/>
      <!-- Centre of the base, just above the chassis plate. -->
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
