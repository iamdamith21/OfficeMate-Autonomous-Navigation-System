<!--
  navigate_through_poses_no_reverse.xml — 2026-08-03

  Nav2's stock navigate_through_poses_w_replanning_and_recovery.xml with the
  <BackUp> recovery REMOVED. Companion to navigate_no_reverse.xml.

  This file is NOT optional. bt_navigator loads the trees for EVERY navigator in
  its `navigators` list at configure time, so overriding only
  default_nav_to_pose_bt_xml leaves navigate_through_poses pointing at the stock
  tree. With the `backup` plugin unloaded from behavior_server that tree throws
  "Action server backup not available", the XML fails to load, and bt_navigator
  never leaves the inactive state — which takes the WHOLE nav stack down, not
  just the through-poses navigator.

  Rationale for dropping BackUp is in navigate_no_reverse.xml: the LTME-02A
  scans -135..+135 deg, so reversing 0.30 m as a recovery drives blind into a
  90 deg unsensed wedge.

  Recovery order matches the sibling tree: Wait before Spin, so fresh scans can
  re-mark the sensed arc after ClearingActions wipes the local costmap.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="0.333">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <ReactiveSequence>
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
            </ReactiveSequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="5"/>
          <Spin spin_dist="1.57"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
