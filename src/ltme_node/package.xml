<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ltme_node</name>
  <version>2.2.2</version>
  <description>ROS 2 driver for LitraTech's newer generation of mechanical 2D LiDARs (LTME-02A, LT-R, LT-I). Ported from the upstream ROS 1 driver.</description>

  <maintainer email="code@litratech.com">LitraTech</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
