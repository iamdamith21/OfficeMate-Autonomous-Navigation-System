<?xml version="1.0"?>
<!--
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  my_robot — 4WD skid-steer file-delivery robot (chassis v3)             │
  │                                                                         │
  │  Minimal TF tree (only functional frames):                             │
  │  base_footprint                                                         │
  │    └─[base_joint fixed z=0.065]─► base_link  (carries ALL static        │
  │         │                          geometry: black bottom box, grey     │
  │         │                          file compartment, black deck, RFID)  │
  │         ├─ laser            (fixed, LTME-02A on the deck)               │
  │         ├─ imu_link         (fixed, centre of base)                    │
  │         ├─ ultrasonic_link  (fixed, HC-SR04 on the front)              │
  │         ├─ door_left_link   / door_right_link   (revolute, grey doors) │
  │         ├─ front_left_wheel_link / front_right_wheel_link (continuous)  │
  │         └─ rear_left_wheel_link  / rear_right_wheel_link  (continuous)  │
  │                                                                         │
  │  Tiers: BLACK bottom box → GREY file compartment (split doors) →        │
  │  BLACK top deck. Deck top 0.60 m; ground clearance lowered.             │
  └─────────────────────────────────────────────────────────────────────────┘
-->
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── Shared utilities ── -->
  <xacro:include filename="$(find robot_description)/urdf/properties.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/inertials.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/materials.xacro"/>

  <!-- ── Sub-components ── -->
  <xacro:include filename="$(find robot_description)/urdf/base/base.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/wheels/drive_wheel.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/sensors/lidar.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/sensors/imu.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/sensors/ultrasonic.xacro"/>

  <!-- ── Instantiate robot ── -->

  <!-- Enclosure (base_link static geometry) + split doors -->
  <xacro:base/>

  <!-- 4WD skid-steer drive wheels (one per corner) -->
  <xacro:drive_wheel prefix="front_left"  x_pos="${wheel_x_offset}"  y_reflect=" 1"/>
  <xacro:drive_wheel prefix="front_right" x_pos="${wheel_x_offset}"  y_reflect="-1"/>
  <xacro:drive_wheel prefix="rear_left"   x_pos="${-wheel_x_offset}" y_reflect=" 1"/>
  <xacro:drive_wheel prefix="rear_right"  x_pos="${-wheel_x_offset}" y_reflect="-1"/>

  <!-- Sensors -->
  <xacro:lidar/>        <!-- on the deck -->
  <xacro:imu/>          <!-- centre of base -->
  <xacro:ultrasonic/>   <!-- HC-SR04 on the front -->

</robot>
